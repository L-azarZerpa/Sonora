<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permiso para leer archivos de audio en Android 13 (API 33) y superior -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Permiso para leer almacenamiento en Android 12 (API 32) e inferior -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Permiso para notificaciones en Android 13 (API 33) y superior -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sonora">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".MusicControlReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ACTION_PREV" />
                <action android:name="ACTION_REWIND_5" />
                <action android:name="ACTION_PLAY_PAUSE" />
                <action android:name="ACTION_FORWARD_5" />
                <action android:name="ACTION_NEXT" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
