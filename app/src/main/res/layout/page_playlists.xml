<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Vista Principal: Mis Listas -->
    <LinearLayout
        android:id="@+id/viewPlaylistsMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible">

        <!-- Encabezado de la página -->
        <TextView
            android:id="@+id/tvPlaylistsPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:text="Mis Listas"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Opción con un más para "Nueva lista de reproducción" -->
        <LinearLayout
            android:id="@+id/btnNewPlaylist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_song_item_art"
                android:contentDescription="Nueva lista"
                android:padding="8dp"
                android:src="@drawable/ic_add"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Nueva lista de reproducción"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Divisor sutil -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider_color" />

        <!-- Header Desplegable para "Listas de reproducción" en color rosa -->
        <LinearLayout
            android:id="@+id/btnTogglePlaylists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvHeaderPlaylists"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Listas de reproducción"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivExpandArrow"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Expandir o colapsar"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/primary" />

        </LinearLayout>

        <!-- Contenedor desplegable de las listas creadas -->
        <LinearLayout
            android:id="@+id/containerPlaylists"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmptyPlaylists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="No tienes listas de reproducción creadas aún."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <ListView
                android:id="@+id/lvPlaylists"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/divider_color"
                android:dividerHeight="1dp"
                android:drawSelectorOnTop="true"
                android:listSelector="?attr/selectableItemBackground" />

        </LinearLayout>

    </LinearLayout>

    <!-- Vista Detalle de una Lista de Reproducción Seleccionada -->
    <LinearLayout
        android:id="@+id/viewPlaylistDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <!-- Header con Flecha de regreso y Nombre de la Lista -->
        <LinearLayout
            android:id="@+id/headerPlaylistDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnBackToPlaylistsMain"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver a mis listas"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tvSelectedPlaylistTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Divisor sutil -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider_color" />

        <!-- Mensaje si la lista está vacía -->
        <TextView
            android:id="@+id/tvEmptyPlaylistDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Esta lista de reproducción no contiene canciones aún."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Lista de canciones dentro de esta playlist -->
        <ListView
            android:id="@+id/lvPlaylistSongsDetail"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/divider_color"
            android:dividerHeight="1dp"
            android:drawSelectorOnTop="true"
            android:listSelector="?attr/selectableItemBackground" />

    </LinearLayout>

</FrameLayout>
